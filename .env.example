# Template only — NEVER put real values here. Real values live in GitHub Environments
# (staging / production) and are written to the server at deploy (docs/DEPLOYMENT.md).
# Production must have APP_ENV=production and APP_DEBUG=false (docs/SECURITY.md §6).
APP_NAME=Hatpakha
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# Newsletters (D58): letters sent per minute by the scheduler (check your host's hourly email limit)
MAIL_BATCH=30
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# D117 (docs/EMAIL.md): newsletters and other bulk mail through Amazon SES (SMTP). Empty = bulk mail uses the mailer above.
MAIL_BULK_HOST=
MAIL_BULK_PORT=587
MAIL_BULK_USERNAME=
MAIL_BULK_PASSWORD=
# At most this many bulk e-mails per 24 hours (0 = no limit); 190 while SES is still in its sandbox.
MAIL_DAILY_LIMIT=0
# D129: Brevo as a second road for newsletters (choose in /desk → চিঠি → পাঠানোর পথ)
MAIL_BREVO_HOST=
MAIL_BREVO_PORT=587
MAIL_BREVO_USERNAME=
MAIL_BREVO_PASSWORD=
MAIL_BREVO_DAILY_LIMIT=290
# D190: the Brevo plan's monthly allowance, a little under it (Starter 5,000 → 4400). Empty or 0 = no monthly limit kept by the site.
MAIL_BREVO_MONTHLY_LIMIT=
# D164: optional; empty = the site makes the secret itself (the full address is shown in /desk → চিঠি → পাঠানোর পথ)
BREVO_WEBHOOK_TOKEN=
# SNS topic that SES sends bounces and complaints to (arn:aws:sns:…)
SES_SNS_TOPIC_ARN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Hatpakha ---
# Old WordPress database (read-only), used only by `php artisan hatpakha:import-wp`.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=
LEGACY_DB_PREFIX=wp_

# Google AdSense (ads render only when the client ID is set)
# true ONLY on the live hatpakha.com (production). Staging/local stay out of Google.
SEO_INDEXABLE=false


# AI review (docs/AI.md). Real keys only in the GitHub Environment ENV_FILE.
AI_ENABLED=false
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_REVIEW_MODEL=
OPENAI_PRICE_IN=
OPENAI_PRICE_OUT=
OPENAI_PRICE_CACHED=
# AI cover illustrations (D43): exact model name from OpenAI's models page, and USD per image
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_PRICE=

# Google Cloud Text-to-Speech (D103): real Bengali voices for ছোটদের হাতপাখা. API key restricted to the Text-to-Speech API.
GOOGLE_TTS_KEY=

# Cloudflare Turnstile (free) for guest comments. Leave empty to rely on honeypot + timing + moderation.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Hostnames our forms are served from (comma-separated). Empty = the APP_URL host. Never localhost in production.
TURNSTILE_HOSTNAMES=

# AdSense (D111). Publisher id is public (also in public/ads.txt). Ads show only on hatpakha.com.
# One slot id per ad spot, created in AdSense (Ads → By ad unit → Display ads); an empty one simply doesn't show.
ADSENSE_CLIENT=ca-pub-4627594058272769
ADSENSE_SLOT_HOME=
ADSENSE_SLOT_HOME_2=
ADSENSE_SLOT_ARTICLE=
ADSENSE_SLOT_ARTICLE_2=
ADSENSE_SLOT_ARTICLE_MID=          # optional (D167): own unit for the mid-story ad; empty = the article unit
ADSENSE_SLOT_SIDEBAR=
ADSENSE_SLOT_LIST=

# D116: social pages (footer links, Organization sameAs) and Meta domain verification code (from Business Settings → Domains)
FACEBOOK_PAGE_URL=https://www.facebook.com/Hatpakhaonline
INSTAGRAM_URL=https://www.instagram.com/hatpakha/
FACEBOOK_DOMAIN_VERIFICATION=
FACEBOOK_APP_ID=
# D127: phone notifications. Generate with `php artisan hatpakha:vapid`; leave empty to keep them off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://hatpakha.com/contact-us/

# D119 (docs/GOOGLE.md): Google Analytics tag + read-only reports for the AI team
GA_MEASUREMENT_ID=
GA_PROPERTY_ID=
SEARCH_CONSOLE_SITE=
GOOGLE_SERVICE_ACCOUNT_JSON=
