# Template only — NEVER put real values here. Real values live in GitHub Environments
# (staging / production) and are written to the server at deploy (docs/DEPLOYMENT.md).
# Production must have APP_ENV=production and APP_DEBUG=false (docs/SECURITY.md §6).
APP_NAME=Hatpakha
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# Newsletters (D58): letters sent per minute by the scheduler (check your host's hourly email limit)
MAIL_BATCH=30
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Hatpakha ---
# Old WordPress database (read-only), used only by `php artisan hatpakha:import-wp`.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=
LEGACY_DB_PREFIX=wp_

# Google AdSense (ads render only when the client ID is set)
# true ONLY on the live hatpakha.com (production). Staging/local stay out of Google.
SEO_INDEXABLE=false

ADSENSE_CLIENT=
ADSENSE_SLOT_ARTICLE=
ADSENSE_SLOT_HOME=

# AI review (docs/AI.md). Real keys only in the GitHub Environment ENV_FILE.
AI_ENABLED=false
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_REVIEW_MODEL=
OPENAI_PRICE_IN=
OPENAI_PRICE_OUT=
OPENAI_PRICE_CACHED=
# AI cover illustrations (D43): exact model name from OpenAI's models page, and USD per image
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_PRICE=

# Cloudflare Turnstile (free) for guest comments. Leave empty to rely on honeypot + timing + moderation.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
