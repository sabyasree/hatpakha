# Hatpakha front controller. Trailing slashes are KEPT (WordPress URLs end with "/"):
# the app enforces them (App\Http\Middleware\EnforceTrailingSlash). See docs/SEO.md §1.
<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Never execute or serve scripts from upload folders (docs/SECURITY.md §5).
    RewriteRule ^(wp-content/uploads|media)/.*\.(php\d?|phtml|phar|pl|py|cgi|sh|asp|aspx|jsp|htaccess)$ - [F,L,NC]

    # Send requests to the front controller (except real files).
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    # Long cache for fingerprinted build assets and uploaded media.
    <FilesMatch "\.(css|js|woff2|webp|avif|jpe?g|png|gif|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
